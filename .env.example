# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL_SMART=            # Sonnet — ID со страницы Models overview
CLAUDE_MODEL_FAST=             # Haiku

# Voyage AI
VOYAGE_API_KEY=
VOYAGE_MODEL=
EMBEDDING_DIM=1024

# Supabase (npx supabase start выводит URL и ключи для локальной базы)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=           # только сервер
SUPABASE_PROJECT_REF=          # ref из URL проекта (для npm run db:types)

# App
SITE_URL=                      # полный origin, например https://your-app.vercel.app
ADMIN_EMAILS=                  # через запятую
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Testing
USE_TEST_ROUTES=            # set to 1 to enable test-only routes (/match-modal-test, /admin-landmark-test, /chat-log-test, /textarea-labels-test); playwright.config.ts sets this automatically for e2e runs
